<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.a6leink.settings">

    <!-- The per-app list shows every launchable app and skips input methods
         (spec 04 section 5, package visibility for target SDK 30). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- The service's own per-app options and automatic switches (spec 05
         section 6.4); signature permission defined by org.a6leink.epd. -->
    <uses-permission android:name="org.a6leink.epd.permission.EINK_OPTIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- Settings > Display: "E-ink apps & tuning" (spec 04 section 6.4).
             Guarded like the service's pages (spec 02 section 7.7). -->
        <activity
            android:name=".EinkSettingsActivity"
            android:label="@string/main_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/main_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/main_summary" />
        </activity>

        <!-- Per-app display mode (spec 04 sections 3 and 6.1). -->
        <activity
            android:name=".AppModeActivity"
            android:label="@string/app_mode_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="false" />

        <!-- E-ink tuning and ghost clearing (spec 04 section 6.1 item 4). -->
        <activity
            android:name=".TuningActivity"
            android:label="@string/tuning_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="false" />
    </application>
</manifest>
