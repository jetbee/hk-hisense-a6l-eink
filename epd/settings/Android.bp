// E-ink settings app (spec 04 section 6): per-app display mode and E-ink
// tuning. Installs to /system_ext/priv-app/A6lEinkSettings.
android_app {
    name: "A6lEinkSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,

    // On the boot class path (PRODUCT_BOOT_JARS); never bundled.
    libs: ["com.hmct.epd"],
}
