<!-- Privileged permissions of the E-ink apps (installed to
     /system_ext/etc/permissions by epd.mk). Platform-signed priv-apps still
     need an allowlist entry for signature|privileged permissions
     (PermissionManagerService), and a missing entry stops the boot when
     ro.control_privapp_permissions=enforce. -->
<permissions>
    <privapp-permissions package="org.a6leink.epd">
        <!-- Video lock (spec 05 section 6.3): uids in audio playback configurations. -->
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
    </privapp-permissions>
</permissions>
