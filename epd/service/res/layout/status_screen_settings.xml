<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_settings_heading"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/colorAccent" />

        <Switch
            android:id="@+id/sleep_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:text="@string/status_settings_clock"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_settings_clock_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/status_settings_style"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <RadioGroup
            android:id="@+id/clock_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/clock_style_analog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/status_settings_style_analog" />

            <RadioButton
                android:id="@+id/clock_style_digital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/status_settings_style_digital" />
        </RadioGroup>

        <!-- Sleep screen widgets (spec 03 section 3) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp"
            android:text="@string/sleep_widgets_heading"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/colorAccent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/sleep_widgets_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <LinearLayout
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/sleep_widgets_empty"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <Button
            android:id="@+id/widget_add"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_widgets_add" />

        <TextView
            android:id="@+id/widget_unavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sleep_widgets_unavailable"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:visibility="gone" />

        <!-- Sleep screen notifications (spec 03 section 4) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp"
            android:text="@string/sleep_notifications_heading"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/colorAccent" />

        <Switch
            android:id="@+id/sleep_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:text="@string/sleep_notifications_switch"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sleep_notifications_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <LinearLayout
            android:id="@+id/notifications_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sleep_notifications_max"
                android:textAppearance="?android:attr/textAppearanceListItem" />

            <TextView
                android:id="@+id/notifications_max_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/sleep_sections_order"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <RadioGroup
            android:id="@+id/sections_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/sections_widgets_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_sections_widgets_first" />

            <RadioButton
                android:id="@+id/sections_notifications_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_sections_notifications_first" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp"
            android:text="@string/buttons_heading"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/colorAccent" />

        <Switch
            android:id="@+id/swap_keys_on_eink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:text="@string/buttons_swap_on_eink"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/buttons_swap_on_eink_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
