<!-- Display options of one sleep screen widget (spec 03 section 3). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sleep_widget_size"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <RadioGroup
            android:id="@+id/widget_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/widget_size_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_widget_size_default" />

            <RadioButton
                android:id="@+id/widget_size_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_widget_size_small" />

            <RadioButton
                android:id="@+id/widget_size_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_widget_size_medium" />

            <RadioButton
                android:id="@+id/widget_size_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_widget_size_large" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/widget_invert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sleep_widget_invert" />

        <CheckBox
            android:id="@+id/widget_contrast_high"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sleep_widget_contrast_high" />
    </LinearLayout>
</ScrollView>
