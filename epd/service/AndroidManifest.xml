<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.a6leink.epd"
    android:sharedUserId="android.uid.system"
    coreApp="true">

    <!-- Only this service may send the display type broadcast (spec 02 section 1.1). -->
    <protected-broadcast android:name="com.hmct.action.displaychanged" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".EpdApplication"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Settings > Security: per-finger unlock screen (spec 02 section 5.3). -->
        <activity
            android:name=".FingerUnlockSettingsActivity"
            android:label="@string/finger_unlock_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.security" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/finger_unlock_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/finger_unlock_summary" />
        </activity>

        <!-- Settings > Display: E-ink status screen (spec 02 section 6.6). -->
        <activity
            android:name=".StatusScreenSettingsActivity"
            android:label="@string/status_settings_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/status_settings_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/status_settings_summary" />
        </activity>
    </application>
</manifest>
