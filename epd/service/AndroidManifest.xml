<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.a6leink.epd"
    android:sharedUserId="android.uid.system"
    coreApp="true">

    <!-- Only this service may send the display type broadcast (spec 02 section 1.1). -->
    <protected-broadcast android:name="com.hmct.action.displaychanged" />
    <!-- Sent by the key handler in system_server on each E-ink key press (spec 02
         section 5.1); protected so that only the system may send it. -->
    <protected-broadcast android:name="com.hmct.intent.EINK_KEY_PRESSED" />

    <!-- The settings app reaches the service's own per-app options with this
         (spec 05 section 6.4). Signature: only apps signed like this one. -->
    <permission
        android:name="org.a6leink.epd.permission.EINK_OPTIONS"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Per-app E-ink behaviour (spec 05 section 6). uid system passes these
         checks anyway; they are declared to document what is used.
         Front app: task stack listener and focused task (signature). -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS" />
    <!-- Camera lock: package of the app opening a camera (signature). -->
    <uses-permission android:name="android.permission.CAMERA_OPEN_CLOSE_LISTENER" />
    <!-- Video lock: uids in audio playback configurations (signature|privileged:
         listed in epd/permissions/privapp-permissions-a6leink.xml). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <!-- Slide one screen (experimental): gesture monitor on display 0 (signature). -->
    <uses-permission android:name="android.permission.MONITOR_INPUT" />

    <application
        android:name=".EpdApplication"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Sleep screen notifications (spec 03 section 4). The service grants itself
             listener access at start. Widgets need BIND_APPWIDGET, which uid system
             passes without declaring it. -->
        <service
            android:name=".SleepNotificationListener"
            android:label="@string/sleep_notification_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Own per-app options for the settings app (spec 05 section 6.4). One
             instance for all users, in the persistent service process. -->
        <provider
            android:name=".EinkOptionsProvider"
            android:authorities="org.a6leink.epd.options"
            android:exported="true"
            android:singleUser="true"
            android:permission="org.a6leink.epd.permission.EINK_OPTIONS" />

        <!-- Quick Settings tile "E-ink: clear/smooth" (spec 05 section 6.5). -->
        <service
            android:name=".EinkModeTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_eink_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Settings > Security: per-finger unlock screen (spec 02 section 5.3). -->
        <activity
            android:name=".FingerUnlockSettingsActivity"
            android:label="@string/finger_unlock_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.security" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/finger_unlock_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/finger_unlock_summary" />
        </activity>

        <!-- Settings > Display: E-ink status screen (spec 02 section 6.6) with the
             sleep screen widgets and notifications (spec 03). -->
        <activity
            android:name=".StatusScreenSettingsActivity"
            android:label="@string/status_settings_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/status_settings_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/status_settings_summary" />
        </activity>
    </application>
</manifest>
