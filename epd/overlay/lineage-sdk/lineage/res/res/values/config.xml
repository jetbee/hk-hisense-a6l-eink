<resources>
    <!-- Device key handlers loaded into system_server (spec 02 section 5.1).
         The first pair keeps the LineageParts handler of the lineage-sdk
         default; the second is the E-ink key handler of the E-ink service.
         The two arrays are matched by index. -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false">
        <item>/system/priv-app/LineageParts/LineageParts.apk</item>
        <item>/system_ext/priv-app/A6lEinkService/A6lEinkService.apk</item>
    </string-array>

    <string-array name="config_deviceKeyHandlerClasses" translatable="false">
        <item>org.lineageos.lineageparts.gestures.KeyHandler</item>
        <item>org.a6leink.epd.EpdKeyHandler</item>
    </string-array>
</resources>
