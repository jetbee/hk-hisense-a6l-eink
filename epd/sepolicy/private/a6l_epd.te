# System-side policy for the E-ink service (spec 02 section 1.3).
# Platform (system) policy: include through BOARD_PLAT_PRIVATE_SEPOLICY_DIR.

# The "epd" binder service. app_api_service: any app may find it (stock had
# no permission checks and stock apps call it).
type a6l_epd_service, app_api_service, service_manager_type;

# The service runs as android.uid.system (domain system_app) and adds itself.
add_service(system_app, a6l_epd_service)

# The E-ink key handler runs in system_server and looks the service up.
allow system_server a6l_epd_service:service_manager find;

# Bridge properties: set by the service, read by init (init reads all
# properties and runs the triggers of init.a6l.epd.rc).
system_internal_prop(a6l_epd_prop)
set_prop(system_app, a6l_epd_prop)

# Automatic camera lock (spec 05 section 6.3): the service registers a camera
# availability listener with cameraserver. system_app may not find it by default.
allow system_app cameraserver_service:service_manager find;
