// Clean-room client library for the A6L E-ink ("epd") system service.
// Intended to be placed on the boot class path (PRODUCT_BOOT_JARS).
java_library {
    name: "com.hmct.epd",
    installable: true,
    platform_apis: true,

    srcs: [
        "src/**/*.java",
        "src/**/I*.aidl",
    ],

    aidl: {
        local_include_dirs: ["src"],
    },

    permitted_packages: ["com.hmct.epd"],
}
